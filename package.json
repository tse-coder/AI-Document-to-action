{
  "name": "ai-document-to-action",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:apply": "psql \"$DATABASE_URL\" -f lib/db/schema.sql && psql \"$DATABASE_URL\" -f seed.sql",
    "db:reset": "psql \"$DATABASE_URL\" -f lib/db/reset.sql"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "~2.100.0",
    "ai": "^4.3.19",
    "chrono-node": "^2.10.3",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
