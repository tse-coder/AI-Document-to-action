# ============================================
# AI Document to Action Agent — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is git-ignored.
# ============================================

# --- Gemini API (Required) ---
# Get from: https://aistudio.google.com/apikey
# Free tier: 15 RPM, 1M tokens/day (Gemini 2.5 Flash)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# --- Supabase Database (Required) ---
# Get from: https://supabase.com/dashboard → Project → Settings → Database → Connection string (URI)
# Free tier: 500MB storage, 2 projects
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
